# Copie para .env (uso local) ou cadastre cada variável no painel do
# CloudPanel (Site > Environment Variables) em produção. Nunca preencha
# valores reais neste arquivo .example — ele é o único que vai pro git.

# Banco de dados (public/db.php)
DB_HOST=127.0.0.1
DB_NAME=liberacash
DB_USER=
DB_PASS=

# Amazon SES (config/aws-config.php via EmailService.php)
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=contato@libera.cash

# Parceiros (config/parceiros-config.php)
VELOTAX_KEY_ID=
VELOTAX_API_KEY=

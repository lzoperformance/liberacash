{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/nav/**",
              "ui_kits/admin-dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Urbanist|Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Urbanist, Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIPromptPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|subheading|suggestions|orbSize|placeholder|model|onSend|tools|compact|key|ref|className|style|children)$/]",
        "message": "<AIPromptPanel> doesn't accept that prop. Declared props: heading, subheading, suggestions, orbSize, placeholder, model, onSend, tools, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:series|compare|height|yTicks|xLabels|marker|fill|key|ref|className|style|children)$/]",
        "message": "<AreaChart> doesn't accept that prop. Declared props: series, compare, height, yTicks, xLabels, marker, fill."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|status|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|offline)$/]",
        "message": "<Avatar> status must be one of 'online' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|icon|delta|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, size, icon, delta, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|pending|warning|neutral|accent|dark)$/]",
        "message": "<Badge> tone must be one of 'success' | 'pending' | 'warning' | 'neutral' | 'accent' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BalanceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|amount|currency|actions|note|height|key|ref|className|style|children)$/]",
        "message": "<BalanceCard> doesn't accept that prop. Declared props: label, amount, currency, actions, note, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|a|b|key|ref|className|style|children)$/]",
        "message": "<BarDatum> doesn't accept that prop. Declared props: label, a, b."
